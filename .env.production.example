# ─── App ────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=RentFlow Sentinel

# ─── Database ───────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/rentflow_sentinel?sslmode=require

# ─── Auth.js ────────────────────────────
# Set a unique secret in your deployment secret manager; never commit it.
AUTH_SECRET=
# Enable only when deployed behind a trusted reverse proxy.
AUTH_TRUST_HOST=true

# ─── Email (password reset) ─────────────
RESEND_API_KEY=
EMAIL_FROM=

# ─── App Configuration ───────────────────
NODE_ENV=production