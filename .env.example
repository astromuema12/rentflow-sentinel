# ─── App ────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RentFlow Sentinel

# ─── Database ───────────────────────────
# Optional direct connection for Prisma CLI; leave blank to use DATABASE_URL.
DIRECT_URL=
DATABASE_URL=postgresql://user:password@localhost:5432/rentflow_sentinel

# ─── Auth.js ────────────────────────────
# Generate a unique local value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ─── Email (password reset) ─────────────
RESEND_API_KEY=
EMAIL_FROM=

# ─── App Configuration ───────────────────
NODE_ENV=development
NEXT_PUBLIC_ENABLE_DESIGN-system=false